
include: "rules/common.smk"
include: "rules/indexing.smk"
include: "rules/mapping.smk"
include: "rules/call.smk"
include: "rules/extract.smk"
include: "rules/report.smk"


rule all:
    input:
        f"{OUTDIR}/report/qc_report.html",
        [f"{prefix(s, 'signals')}_coverage_{strand}.bw" for s in SAMPLES for strand in ("neg", "pos")],
        [
            f"{prefix(s, 'signals')}_{context}_{strand}.bw"
            for s in SAMPLES
            for context in ("cpg", "chg", "chh")
            for strand in ("neg", "pos")
        ],
        [f"{prefix(s, 'methylc')}_methylc.bed.gz" for s in SAMPLES],
        [f"{prefix(s, 'align')}_qc.json" for s in SAMPLES],
        [f"{prefix(s, 'align')}.bam.md5" for s in SAMPLES],
        [f"{prefix(s, 'call')}.bcf.md5" for s in SAMPLES],
