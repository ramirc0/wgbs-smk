
include: "rules/common.smk"
include: "rules/indexing.smk"
include: "rules/mapping.smk"
include: "rules/call.smk"
include: "rules/extract.smk"


rule all:
    input:
        [f"{prefix(s)}_coverage_{strand}.bw" for s in SAMPLES for strand in ("neg", "pos")],
        [
            f"{prefix(s)}_{context}_{strand}.bw"
            for s in SAMPLES
            for context in ("cpg", "chg", "chh")
            for strand in ("neg", "pos")
        ],
        [f"{prefix(s)}_methylc.bed.gz" for s in SAMPLES],
